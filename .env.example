# Copy to .env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=8000
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DB_PATH=backend/.data/sweetmate.sqlite
INDEX_PATH=bm25/data/generated/bm25-index.json.gz
SESSION_DAYS=7
ANALYTICS_DAYS=90
COOKIE_SECURE=false
# Set BOTH to create the first admin on startup. Registration always creates user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# none | gigachat | openai-compatible
LLM_PROVIDER=gigachat
LLM_API_KEY=
LLM_MODEL=GigaChat-2
LLM_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_TIMEOUT_MS=20000
# Never disable TLS certificate verification.

# Official GigaChat CA, scoped to this LLM client.
LLM_CA_FILE=backend/certs/russian_trusted_root_ca.pem
